{
  "$name": "archar-theme",
  "$source": "https://archar.framer.website/",
  "$description": "Design tokens extracted from the Archar portfolio site. Editorial grotesk system: one typeface, monochrome base, single hot-orange accent, sub-1.0 display leading.",
  "color": {
    "black": "#000000",
    "ink": "#161616",
    "grey-600": "#7a7a7a",
    "grey-500": "#8b8b8b",
    "grey-100": "#f3f3f3",
    "white": "#ffffff",
    "accent": "#ff6d10"
  },
  "semantic": {
    "light": {
      "bg-page": "#ffffff",
      "bg-surface": "#f3f3f3",
      "text-primary": "#000000",
      "text-secondary": "#7a7a7a",
      "text-muted": "#8b8b8b",
      "text-inverse": "#ffffff"
    },
    "dark": {
      "bg-page": "#000000",
      "bg-surface": "#161616",
      "text-primary": "#ffffff",
      "text-secondary": "#8b8b8b",
      "text-muted": "#7a7a7a",
      "text-inverse": "#000000"
    }
  },
  "font": {
    "family": {
      "sans": "\"Switzer\", \"Inter\", -apple-system, BlinkMacSystemFont, sans-serif"
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700,
      "black": 900
    },
    "size": {
      "display": { "phone": "60px", "tablet": "88px", "desktop": "120px" },
      "h1": { "phone": "44px", "tablet": "60px", "desktop": "88px" },
      "h2": { "phone": "36px", "tablet": "46px", "desktop": "58px" },
      "h3": { "phone": "30px", "tablet": "38px", "desktop": "46px" },
      "h4": "24px",
      "body": "16px",
      "small": "14px",
      "caption": "12px"
    },
    "lineHeight": {
      "display": 0.76,
      "tight": 0.8,
      "snug": 0.9,
      "none": 1.0,
      "body": 1.2,
      "relaxed": 1.4
    },
    "letterSpacing": {
      "display": "-0.06em",
      "heading": "-0.04em",
      "tight": "-0.03em",
      "body": "-0.02em",
      "none": "0em"
    }
  },
  "space": {
    "3xs": "5px",
    "2xs": "10px",
    "xs": "14px",
    "sm": "20px",
    "md": "30px",
    "lg": "50px",
    "xl": "70px",
    "2xl": "100px",
    "3xl": "150px",
    "4xl": "250px"
  },
  "radius": {
    "xs": "3px",
    "md": "10px",
    "pill": "100px",
    "full": "9999px"
  },
  "shadow": {
    "none": "none",
    "hairline": "inset 0 0 0 1px #000000",
    "overlay": "0 0 20px 5px rgba(0, 0, 0, 0.3)",
    "glow": "0 0 30px 0 rgba(255, 107, 15, 0.7)"
  },
  "scrim": "rgba(0, 0, 0, 0.57)",
  "breakpoint": {
    "phone": "810px",
    "tablet": "1200px",
    "desktop": "1920px"
  },
  "layout": {
    "container": "1200px",
    "containerWide": "1920px",
    "gutter": "20px",
    "grid": { "columns": 2, "min": "50px", "collapseBelow": "810px" }
  },
  "motion": {
    "easing": {
      "out": "cubic-bezier(0.16, 1, 0.3, 1)",
      "inOut": "cubic-bezier(0.65, 0, 0.35, 1)"
    },
    "duration": { "fast": "150ms", "base": "300ms", "slow": "600ms" }
  }
}
