{
  "$name": "archar-theme",
  "$version": "2.0.0",
  "$source": "https://archar.framer.website/",
  "$method": "Computed styles measured in Chromium at 390 / 900 / 1440 viewports, cross-checked against the source stylesheet.",
  "$description": "Editorial portfolio system: grotesk display type set below 1.0 leading, monochrome base, single hot-orange accent, near-flat elevation.",
  "color": {
    "black": "#000000",
    "ink": "#161616",
    "grey-700": "#636363",
    "grey-650": "#707070",
    "grey-600": "#7a7a7a",
    "grey-500": "#8b8b8b",
    "grey-100": "#f3f3f3",
    "white": "#ffffff",
    "accent": "#ff6d10",
    "$note": "Seven of these (#000, #161616, #7a7a7a, #8b8b8b, #f3f3f3, #fff, #ff6d10) are declared Framer design tokens. grey-700 and grey-650 appear only in painted output."
  },
  "semantic": {
    "light": {
      "bg-page": "#ffffff",
      "bg-surface": "#f3f3f3",
      "text-primary": "#000000",
      "text-secondary": "#7a7a7a",
      "text-muted": "#8b8b8b",
      "text-inverse": "#ffffff"
    },
    "dark": {
      "bg-page": "#000000",
      "bg-surface": "#161616",
      "text-primary": "#ffffff",
      "text-secondary": "#8b8b8b",
      "text-muted": "#7a7a7a",
      "text-inverse": "#000000"
    },
    "scrim": "rgba(0, 0, 0, 0.57)"
  },
  "font": {
    "family": {
      "display": "\"Switzer\", \"Inter\", -apple-system, sans-serif",
      "body": "\"Switzer\", \"Inter\", -apple-system, sans-serif",
      "project": "\"Inter\", \"Switzer\", -apple-system, sans-serif"
    },
    "weight": { "regular": 400, "semibold": 600 },
    "size": {
      "display":  { "phone": "58px", "tablet": "80px", "desktop": "120px" },
      "h1":       { "phone": "42px", "tablet": "58px", "desktop": "88px" },
      "h2":       { "phone": "36px", "tablet": "46px", "desktop": "58px" },
      "h3":       { "phone": "30px", "tablet": "38px", "desktop": "48px" },
      "lead": "60.84px",
      "project": "22px",
      "body": "14px",
      "label": "14px",
      "caption": "12px",
      "wordmark": "177px"
    },
    "lineHeight": {
      "wordmark": 0.76,
      "tight": 0.8,
      "display": 0.9,
      "none": 1.0,
      "snug": 1.2,
      "body": 1.4
    },
    "letterSpacing": {
      "display": "-0.06em",
      "heading": "-0.04em",
      "snug": "-0.03em",
      "body": "-0.02em",
      "none": "normal"
    }
  },
  "space": {
    "3xs": "5px",
    "2xs": "10px",
    "xs": "14px",
    "sm": "20px",
    "md": "30px",
    "lg": "50px",
    "xl": "70px",
    "2xl": "100px",
    "3xl": "150px",
    "4xl": "250px"
  },
  "radius": {
    "xs": "3px",
    "sm": "5px",
    "md": "10px",
    "lg": "50px",
    "pill": "100px",
    "full": "1000px"
  },
  "shadow": {
    "none": "none",
    "hairline": "inset 0 0 0 1px #000000",
    "overlay": "0 0 20px 5px rgba(0, 0, 0, 0.3)",
    "soft": "0 0.6px 1.57px -1.5px rgba(0,0,0,0.17), 0 2.29px 5.9px -3px rgba(0,0,0,0.14)",
    "glow": "0 0 30px 0 rgba(255, 107, 15, 0.7)"
  },
  "breakpoint": { "phone": "810px", "tablet": "1200px" },
  "layout": {
    "container": "1400px",
    "gutter": "20px",
    "gutterPhone": "16px",
    "colHalf": "700px",
    "colThird": "460px",
    "measured": {
      "390": { "content": "358px", "gutter": "16px" },
      "900": { "content": "860px", "gutter": "20px" },
      "1440": { "content": "1400px", "gutter": "20px" }
    }
  },
  "motion": {
    "$note": "NOT measured. The page ships zero CSS transitions; all motion is JS-driven (Framer Motion), so no curve is recoverable from computed style. These are rebuild defaults.",
    "easing": {
      "out": "cubic-bezier(0.16, 1, 0.3, 1)",
      "inOut": "cubic-bezier(0.65, 0, 0.35, 1)"
    },
    "duration": { "fast": "150ms", "base": "300ms" }
  }
}
